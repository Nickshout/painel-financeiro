# Copie este arquivo para .env.local e preencha os valores.
# .env.local NUNCA deve ser commitado.

# Personal Access Token do Airtable (scopes: data.records:read, data.records:write)
AIRTABLE_PAT=

# ID da base do Airtable (comeca com "app...", visivel na URL da base)
AIRTABLE_BASE_ID=

# API key da GNews.io (https://gnews.io/dashboard)
GNEWS_API_KEY=

# Segredo compartilhado entre o GitHub Actions e a rota /api/cron
# Enviado no header x-cron-secret. Gere um valor aleatorio longo.
CRON_SECRET=
